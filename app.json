{
  "expo": {
    "name": "Vision Assist",
    "slug": "vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "privacy": "public",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vision Assist to access your camera when you choose to scan a banknote.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Vision Assist to listen only when you start a voice command.",
          "speechRecognitionPermission": "Allow Vision Assist to turn your spoken command into text."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.archcity.visionassist",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Vision Assist to turn your spoken command into text.",
        "NSMicrophoneUsageDescription": "Allow Vision Assist to listen only when you start a voice command."
      }
    },
    "android": {
      "package": "com.archcity.visionassist",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "04b58089-39fd-4c19-be26-d97c0e0b82ae"
      }
    },
    "owner": "archcity"
  }
}
